{
  "name": "indexfootball",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "IndexFootball — the free football encyclopedia. Players, clubs, leagues, matches and history as a static site.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "index:search": "pagefind --site dist",
    "build:full": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "fetch:openfootball": "tsx scripts/fetch-openfootball.ts",
    "fetch:all": "npm run fetch:openfootball",
    "enrich:sportsdb": "tsx scripts/fetch-sportsdb.ts",
    "process": "tsx scripts/process-data.ts",
    "data": "npm run fetch:all && npm run process"
  },
  "dependencies": {
    "astro": "^5.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.4.0",
    "@tailwindcss/vite": "^4.1.0",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.0",
    "vite": "^6.4.0"
  },
  "optionalDependencies": {
    "pagefind": "^1.3.0"
  }
}
