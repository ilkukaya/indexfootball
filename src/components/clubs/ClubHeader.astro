---
import type { Club, League } from "../../lib/types.ts";
import Breadcrumbs from "../seo/Breadcrumbs.astro";
import Logo from "../ui/Logo.astro";

interface Props {
  club: Club;
  leagues: League[];
  active: "overview" | "squad" | "history" | "matches";
}

const { club, leagues, active } = Astro.props;
const base = `/clubs/${club.slug}`;

const tabs = [
  { id: "overview", label: "Overview", href: `${base}/` },
  { id: "squad", label: "Squad", href: `${base}/squad` },
  { id: "history", label: "History", href: `${base}/history` },
  { id: "matches", label: "Matches", href: `${base}/matches` },
];

const pills: string[] = [club.country];
if (club.founded !== null) pills.push(`Founded ${club.founded}`);
if (club.stadium) pills.push(club.stadium);
---

<div>
  <Breadcrumbs
    items={[
      { label: "Home", href: "/" },
      { label: "Clubs", href: "/clubs/" },
      { label: club.name },
    ]}
  />

  <div class="mt-3 flex items-center gap-4">
    <Logo name={club.name} slug={club.slug} crest={club.crest} size={64} />
    <div>
      <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
        {club.name}
      </h1>
      <div class="mt-2 flex flex-wrap gap-1.5">
        {
          pills.map((pill) => (
            <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600">
              {pill}
            </span>
          ))
        }
        {
          leagues.map((league) => (
            <a
              href={`/leagues/${league.slug}/`}
              class="rounded-full bg-pitch-50 px-2.5 py-0.5 text-xs font-medium text-pitch-700 hover:bg-pitch-100"
            >
              {league.name}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <nav class="mt-5 border-b border-slate-200" aria-label="Club sections">
    <ul class="flex gap-1">
      {
        tabs.map((tab) => (
          <li>
            <a
              href={tab.href}
              aria-current={active === tab.id ? "page" : undefined}
              class:list={[
                "inline-block border-b-2 px-3 py-2 text-sm font-medium transition-colors",
                active === tab.id
                  ? "border-pitch-600 text-pitch-700"
                  : "border-transparent text-slate-500 hover:text-slate-800",
              ]}
            >
              {tab.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
