---
const links = [
  { href: "/leagues/", label: "Leagues" },
  { href: "/clubs/", label: "Clubs" },
  { href: "/players/", label: "Players" },
  { href: "/search", label: "Search" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));
---

<header class="border-b border-slate-200 bg-white">
  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8"
  >
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-pitch-600 text-sm font-black text-white"
        aria-hidden="true"
      >
        IF
      </span>
      <span>Index<span class="text-pitch-600">Football</span></span>
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-1 text-sm font-medium sm:gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                class:list={[
                  "rounded-md px-2 py-1.5 transition-colors hover:bg-pitch-50 hover:text-pitch-700 sm:px-3",
                  isActive(link.href)
                    ? "text-pitch-700"
                    : "text-slate-600",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
