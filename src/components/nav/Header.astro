---
const links = [
  { href: "/leagues/", label: "Leagues" },
  { href: "/clubs/", label: "Clubs" },
  { href: "/search", label: "Search" },
  { href: "/about", label: "About" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href.replace(/\/$/, ""));
---

<header
  class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950"
>
  <div
    class="mx-auto flex w-full max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8"
  >
    <a href="/" class="flex items-center gap-2 text-lg font-bold tracking-tight">
      <span
        class="inline-flex h-8 w-8 items-center justify-center rounded-md bg-pitch-600 text-sm font-black text-white"
        aria-hidden="true"
      >
        IF
      </span>
      <span>Index<span class="text-pitch-600">Football</span></span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <nav aria-label="Primary">
        <ul class="flex items-center gap-1 text-sm font-medium sm:gap-2">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isActive(link.href) ? "page" : undefined}
                  class:list={[
                    "rounded-md px-2 py-1.5 transition-colors hover:bg-pitch-50 hover:text-pitch-700 dark:hover:bg-slate-800 sm:px-3",
                    isActive(link.href)
                      ? "text-pitch-700 dark:text-pitch-400"
                      : "text-slate-600 dark:text-slate-300",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="rounded-md p-1.5 text-slate-500 transition-colors hover:bg-pitch-50 hover:text-pitch-700 dark:text-slate-400 dark:hover:bg-slate-800"
      >
        <svg
          class="hidden h-5 w-5 dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <path
            d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"
          ></path>
        </svg>
        <svg
          class="block h-5 w-5 dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
