---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-slate-500">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {item.href && i < items.length - 1 ? (
            <a href={item.href} class="hover:text-pitch-700 hover:underline">
              {item.label}
            </a>
          ) : (
            <span class="text-slate-700" aria-current="page">
              {item.label}
            </span>
          )}
          {i < items.length - 1 && (
            <span class="text-slate-300" aria-hidden="true">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
