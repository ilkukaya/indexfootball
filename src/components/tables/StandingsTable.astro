---
import type { Club, Match } from "../../lib/types.ts";
import { computeStandings } from "../../lib/standings.ts";
import Logo from "../ui/Logo.astro";

interface Props {
  matches: Match[];
  clubs: Club[];
  season: string;
}

const { matches, clubs } = Astro.props;
const standings = computeStandings(matches, clubs);

const formClass: Record<string, string> = {
  W: "bg-pitch-600 text-white",
  D: "bg-slate-300 text-slate-700",
  L: "bg-red-500 text-white",
};
---

<div class="overflow-x-auto">
  <table class="w-full border-collapse text-sm">
    <thead class="sticky top-0 bg-white">
      <tr class="border-b border-slate-300 text-left text-xs uppercase tracking-wide text-slate-500">
        <th class="py-2 pr-2 text-right font-medium">#</th>
        <th class="py-2 pl-2 font-medium">Club</th>
        <th class="py-2 px-2 text-right font-medium" title="Played">P</th>
        <th class="py-2 px-2 text-right font-medium" title="Won">W</th>
        <th class="py-2 px-2 text-right font-medium" title="Drawn">D</th>
        <th class="py-2 px-2 text-right font-medium" title="Lost">L</th>
        <th class="hidden py-2 px-2 text-right font-medium sm:table-cell" title="Goals for">GF</th>
        <th class="hidden py-2 px-2 text-right font-medium sm:table-cell" title="Goals against">GA</th>
        <th class="py-2 px-2 text-right font-medium" title="Goal difference">GD</th>
        <th class="py-2 px-2 text-right font-medium" title="Points">Pts</th>
        <th class="hidden py-2 pl-3 font-medium md:table-cell">Form</th>
      </tr>
    </thead>
    <tbody>
      {
        standings.map((s) => (
          <tr class="border-b border-slate-100 hover:bg-slate-50">
            <td class="py-2 pr-2 text-right tabular-nums text-slate-500">
              {s.position}
            </td>
            <td class="py-2 pl-2">
              <a
                href={`/clubs/${s.club.slug}/`}
                class="flex items-center gap-2 font-medium text-slate-900 hover:text-pitch-700"
              >
                <Logo
                  name={s.club.name}
                  slug={s.club.slug}
                  crest={s.club.crest}
                  size={22}
                />
                {s.club.name}
              </a>
            </td>
            <td class="py-2 px-2 text-right tabular-nums">{s.played}</td>
            <td class="py-2 px-2 text-right tabular-nums">{s.won}</td>
            <td class="py-2 px-2 text-right tabular-nums">{s.drawn}</td>
            <td class="py-2 px-2 text-right tabular-nums">{s.lost}</td>
            <td class="hidden py-2 px-2 text-right tabular-nums sm:table-cell">
              {s.gf}
            </td>
            <td class="hidden py-2 px-2 text-right tabular-nums sm:table-cell">
              {s.ga}
            </td>
            <td class="py-2 px-2 text-right tabular-nums">
              {s.gd > 0 ? `+${s.gd}` : s.gd}
            </td>
            <td class="py-2 px-2 text-right font-bold tabular-nums">
              {s.points}
            </td>
            <td class="hidden py-2 pl-3 md:table-cell">
              <span class="flex gap-1">
                {s.form.map((r) => (
                  <span
                    class:list={[
                      "inline-flex h-5 w-5 items-center justify-center rounded text-[10px] font-bold",
                      formClass[r],
                    ]}
                    title={r}
                  >
                    {r}
                  </span>
                ))}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
