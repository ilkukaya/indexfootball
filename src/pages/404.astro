---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — IndexFootball"
  description="The page you were looking for could not be found."
  noindex
  searchable={false}
>
  <section class="py-16 text-center">
    <p class="text-6xl font-extrabold text-pitch-600">404</p>
    <h1 class="mt-4 text-2xl font-bold">Page not found</h1>
    <p class="mx-auto mt-2 max-w-md text-slate-600 dark:text-slate-400">
      The page you were looking for doesn&rsquo;t exist or may have moved.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/search"
        class="rounded-lg bg-pitch-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-pitch-700"
      >
        Search the site
      </a>
      <a
        href="/leagues/"
        class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-pitch-300 hover:text-pitch-700 dark:border-slate-700 dark:text-slate-200 dark:hover:border-pitch-700 dark:hover:text-pitch-400"
      >
        Browse leagues
      </a>
    </div>
  </section>
</BaseLayout>
