---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";

const sources = [
  {
    name: "OpenFootball",
    href: "https://github.com/openfootball",
    note: "Match results, fixtures and seasons for the leagues we cover. Licensed CC BY.",
  },
  {
    name: "TheSportsDB",
    href: "https://www.thesportsdb.com",
    note: "Club crests, founding years and venue metadata.",
  },
  {
    name: "Wikidata",
    href: "https://www.wikidata.org",
    note: "Reference data and biographies (rolling out in a future update).",
  },
];
---

<BaseLayout
  title="About & Data Sources — IndexFootball"
  description="About IndexFootball — a free, open-data football encyclopedia of leagues, clubs, matches and history. Data sources and disclaimers."
>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "About" }]} />

  <div class="mt-3 max-w-2xl">
    <h1 class="text-3xl font-extrabold tracking-tight">About IndexFootball</h1>

    <p class="mt-4 text-slate-600 dark:text-slate-300">
      IndexFootball is a free football encyclopedia: standings, fixtures,
      results, clubs and season history across Europe&rsquo;s top leagues. It is
      a <strong>stats-and-history</strong> reference built entirely on open data —
      no market values, no paywall, no ads-driven rumours.
    </p>

    <h2 class="mt-8 text-xl font-bold">Data sources</h2>
    <ul class="mt-3 space-y-3">
      {
        sources.map((source) => (
          <li class="rounded-lg border border-slate-200 p-4 dark:border-slate-800">
            <a
              href={source.href}
              rel="noopener"
              target="_blank"
              class="font-semibold text-pitch-700 hover:underline dark:text-pitch-400"
            >
              {source.name}
            </a>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
              {source.note}
            </p>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-8 text-xl font-bold">Disclaimer</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-300">
      Club crests, logos and photos belong to their respective owners.
      IndexFootball is an independent, non-commercial reference project and is
      not affiliated with any club, league or governing body. Standings are
      computed from raw match data and may differ from official tables where
      points deductions or other administrative adjustments apply.
    </p>
  </div>
</BaseLayout>
