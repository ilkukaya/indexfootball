---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ClubHeader from "../../../components/clubs/ClubHeader.astro";
import MatchCard from "../../../components/cards/MatchCard.astro";
import JsonLd from "../../../components/seo/JsonLd.astro";
import {
  getClubs,
  getClub,
  getLeague,
  getMatchesByClub,
} from "../../../lib/data.ts";
import { clubMeta, clubSchema } from "../../../lib/seo.ts";

export const getStaticPaths = (() => {
  return getClubs().map((club) => ({ params: { slug: club.slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const club = getClub(slug);
if (!club) return Astro.redirect("/clubs/");

const leagues = club.league_ids
  .map((id) => getLeague(id))
  .filter((l) => l !== undefined);

const clubMatches = getMatchesByClub(club.id);
const clubById = new Map(getClubs().map((c) => [c.id, c]));

const recent = [...clubMatches]
  .filter((m) => m.score.ft)
  .sort(
    (a, b) =>
      (b.date ?? "").localeCompare(a.date ?? "") ||
      (b.time ?? "").localeCompare(a.time ?? ""),
  )
  .slice(0, 6);

const meta = clubMeta(club, leagues);
---

<BaseLayout title={meta.title} description={meta.description}>
  <JsonLd schema={clubSchema(club, leagues, Astro.site)} />
  <ClubHeader club={club} leagues={leagues} active="overview" />

  <div class="mt-6 grid gap-8 lg:grid-cols-2">
    <section>
      <div class="flex items-end justify-between">
        <h2 class="text-lg font-semibold">Recent matches</h2>
        <a href={`/clubs/${club.slug}/matches`} class="text-sm text-pitch-700 hover:underline">
          All matches
        </a>
      </div>
      <div class="mt-3 space-y-1.5">
        {
          recent.length > 0 ? (
            recent.map((m) => {
              const home = clubById.get(m.home_club_id);
              const away = clubById.get(m.away_club_id);
              return home && away ? (
                <MatchCard match={m} home={home} away={away} />
              ) : null;
            })
          ) : (
            <p class="text-sm text-slate-500">No matches recorded yet.</p>
          )
        }
      </div>
    </section>

    <section>
      <h2 class="text-lg font-semibold">Squad</h2>
      <p class="mt-3 rounded-lg border border-dashed border-slate-300 p-4 text-sm text-slate-500 dark:border-slate-700 dark:text-slate-400">
        Squad data isn&rsquo;t available from our open-data sources yet. See the
        <a href={`/clubs/${club.slug}/squad`} class="text-pitch-700 hover:underline">
          squad page
        </a>
        for details, or explore the club&rsquo;s
        <a href={`/clubs/${club.slug}/history`} class="text-pitch-700 hover:underline">
          season history
        </a>.
      </p>
    </section>
  </div>
</BaseLayout>
