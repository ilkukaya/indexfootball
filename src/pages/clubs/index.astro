---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/seo/Breadcrumbs.astro";
import ClubCard from "../../components/cards/ClubCard.astro";
import { getClubs } from "../../lib/data.ts";
import { clubsIndexMeta } from "../../lib/seo.ts";

const clubs = getClubs();
const meta = clubsIndexMeta(clubs.length);

// Group A–Z by first letter (non-letters bucket under "#").
const groups = new Map<string, typeof clubs>();
for (const club of clubs) {
  const first = club.name[0]?.toUpperCase() ?? "#";
  const key = /[A-Z]/.test(first) ? first : "#";
  const list = groups.get(key) ?? [];
  list.push(club);
  groups.set(key, list);
}
const letters = [...groups.keys()].sort();
---

<BaseLayout title={meta.title} description={meta.description}>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Clubs" }]} />

  <h1 class="mt-3 text-3xl font-extrabold tracking-tight">Clubs</h1>
  <p class="mt-2 text-slate-600">{clubs.length} clubs · browse A–Z or search.</p>

  <input
    id="club-search"
    type="search"
    placeholder="Search clubs…"
    aria-label="Search clubs"
    autocomplete="off"
    class="mt-5 w-full max-w-md rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm focus:border-pitch-500 focus:outline-none focus:ring-1 focus:ring-pitch-500 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
  />

  <nav class="mt-4 flex flex-wrap gap-1 text-sm" aria-label="Jump to letter">
    {
      letters.map((letter) => (
        <a
          href={`#letter-${letter}`}
          class="rounded px-2 py-1 font-medium text-slate-500 hover:bg-pitch-50 hover:text-pitch-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-pitch-400"
        >
          {letter}
        </a>
      ))
    }
  </nav>

  <div id="club-groups" class="mt-6 space-y-8">
    {
      letters.map((letter) => (
        <section id={`letter-${letter}`} data-letter-group>
          <h2 class="mb-3 text-lg font-bold text-slate-400">{letter}</h2>
          <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {groups.get(letter)!.map((club) => (
              <ClubCard club={club} />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <p id="no-results" class="mt-6 hidden text-sm text-slate-500">
    No clubs match your search.
  </p>
</BaseLayout>

<script>
  const input = document.getElementById("club-search") as HTMLInputElement;
  const groups = document.querySelectorAll<HTMLElement>("[data-letter-group]");
  const cards = document.querySelectorAll<HTMLElement>("[data-club-name]");
  const noResults = document.getElementById("no-results");

  input?.addEventListener("input", () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const match = !q || (card.dataset.clubName ?? "").includes(q);
      card.style.display = match ? "" : "none";
      if (match) visible += 1;
    });

    groups.forEach((group) => {
      const anyVisible = group.querySelector<HTMLElement>(
        '[data-club-name]:not([style*="display: none"])',
      );
      group.style.display = anyVisible ? "" : "none";
    });

    noResults?.classList.toggle("hidden", visible !== 0);
  });
</script>
