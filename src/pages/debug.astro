---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getLeagues,
  getClubs,
  getMatches,
  getMatchesByLeagueSeason,
} from "../lib/data.ts";
import { computeStandings } from "../lib/standings.ts";

// Temporary pipeline verification page (Phase 2). Removed in a later phase.
const leagues = getLeagues();
const clubs = getClubs();
const matches = getMatches();

const pl = leagues.find((l) => l.slug === "premier-league");
const season = pl?.seasons[0] ?? "2024-25";
const leagueMatches = pl ? getMatchesByLeagueSeason(pl.id, season) : [];
const leagueClubs = pl
  ? clubs.filter((c) => c.league_ids.includes(pl.id))
  : [];
const standings = computeStandings(leagueMatches, leagueClubs);
---

<BaseLayout title="Debug — IndexFootball" noindex>
  <h1 class="text-2xl font-bold">Pipeline debug</h1>
  <p class="mt-1 text-sm text-slate-500">
    Temporary page verifying the Phase 2 data pipeline.
  </p>

  <dl class="mt-6 grid grid-cols-3 gap-4">
    <div class="rounded-lg border border-slate-200 p-4">
      <dt class="text-xs uppercase text-slate-500">Leagues</dt>
      <dd class="text-2xl font-bold">{leagues.length}</dd>
    </div>
    <div class="rounded-lg border border-slate-200 p-4">
      <dt class="text-xs uppercase text-slate-500">Clubs</dt>
      <dd class="text-2xl font-bold">{clubs.length}</dd>
    </div>
    <div class="rounded-lg border border-slate-200 p-4">
      <dt class="text-xs uppercase text-slate-500">Matches</dt>
      <dd class="text-2xl font-bold">{matches.length}</dd>
    </div>
  </dl>

  <h2 class="mt-8 text-lg font-semibold">
    {pl?.name} {season} — computed table ({leagueMatches.length} matches)
  </h2>
  <table class="mt-3 w-full text-sm">
    <thead>
      <tr class="border-b border-slate-300 text-left text-slate-500">
        <th class="py-1 pr-2">#</th>
        <th class="py-1 pr-2">Club</th>
        <th class="py-1 pr-2 text-right">P</th>
        <th class="py-1 pr-2 text-right">W</th>
        <th class="py-1 pr-2 text-right">D</th>
        <th class="py-1 pr-2 text-right">L</th>
        <th class="py-1 pr-2 text-right">GF</th>
        <th class="py-1 pr-2 text-right">GA</th>
        <th class="py-1 pr-2 text-right">GD</th>
        <th class="py-1 pr-2 text-right">Pts</th>
        <th class="py-1 pl-2">Form</th>
      </tr>
    </thead>
    <tbody>
      {
        standings.map((s) => (
          <tr class="border-b border-slate-100">
            <td class="py-1 pr-2 tabular-nums">{s.position}</td>
            <td class="py-1 pr-2">{s.club.name}</td>
            <td class="py-1 pr-2 text-right tabular-nums">{s.played}</td>
            <td class="py-1 pr-2 text-right tabular-nums">{s.won}</td>
            <td class="py-1 pr-2 text-right tabular-nums">{s.drawn}</td>
            <td class="py-1 pr-2 text-right tabular-nums">{s.lost}</td>
            <td class="py-1 pr-2 text-right tabular-nums">{s.gf}</td>
            <td class="py-1 pr-2 text-right tabular-nums">{s.ga}</td>
            <td class="py-1 pr-2 text-right tabular-nums">{s.gd}</td>
            <td class="py-1 pr-2 text-right font-semibold tabular-nums">
              {s.points}
            </td>
            <td class="py-1 pl-2 font-mono text-xs text-slate-500">
              {s.form.join(" ")}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</BaseLayout>
