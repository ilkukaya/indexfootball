---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLeagues } from "../lib/data.ts";
import { displaySeason } from "../lib/format.ts";

const leagues = getLeagues();
const featured = leagues[0];
const featuredSeason = featured?.seasons[0];

const features = [
  {
    title: "Leagues & standings",
    body: "Computed tables, fixtures and results for the top European leagues across decades of history.",
    href: "/leagues/",
  },
  {
    title: "Clubs & players",
    body: "Club profiles with season-by-season history and recent matches. Player careers and biographies are coming soon.",
    href: "/clubs/",
  },
  {
    title: "Matches & history",
    body: "Match detail pages and cross-season records — a searchable encyclopedia of the game.",
    href: undefined,
  },
];
---

<BaseLayout>
  <section class="py-12 text-center sm:py-20">
    <h1
      class="mx-auto max-w-3xl text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl"
    >
      The free football encyclopedia
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      Players, clubs, leagues, matches and history — open data, no paywall.
      A stats-and-history reference for the world&rsquo;s game.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/leagues/"
        class="rounded-lg bg-pitch-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-pitch-700"
      >
        Browse leagues
      </a>
      {
        featured && featuredSeason && (
          <a
            href={`/leagues/${featured.slug}/${featuredSeason}/table`}
            class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 transition-colors hover:border-pitch-300 hover:text-pitch-700 dark:border-slate-700 dark:text-slate-200 dark:hover:border-pitch-700 dark:hover:text-pitch-400"
          >
            {featured.name} {displaySeason(featuredSeason)} table
          </a>
        )
      }
    </div>
  </section>

  <section aria-labelledby="what-youll-find" class="border-t border-slate-200 py-12 dark:border-slate-800">
    <h2 id="what-youll-find" class="sr-only">What you'll find</h2>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) =>
          feature.href ? (
            <a
              href={feature.href}
              class="block rounded-xl border border-slate-200 bg-white p-6 transition-colors hover:border-pitch-300 hover:bg-pitch-50 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-pitch-700 dark:hover:bg-slate-800"
            >
              <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
                {feature.title}
              </h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{feature.body}</p>
            </a>
          ) : (
            <div class="rounded-xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
              <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
                {feature.title}
              </h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{feature.body}</p>
              <p class="mt-3 text-xs font-medium uppercase tracking-wide text-slate-400">
                Coming soon
              </p>
            </div>
          ),
        )
      }
    </div>
  </section>
</BaseLayout>
