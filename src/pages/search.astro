---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/seo/Breadcrumbs.astro";
---

<BaseLayout
  title="Search — IndexFootball"
  description="Search IndexFootball: leagues, clubs, matches and seasons across Europe's top competitions."
>
  <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Search" }]} />

  <h1 class="mt-3 text-3xl font-extrabold tracking-tight">Search</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-400">
    Find leagues, clubs and matches across every season.
  </p>

  <div id="search" class="mt-6"></div>

  <noscript>
    <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">
      Search requires JavaScript. Browse <a href="/leagues/" class="text-pitch-700 hover:underline dark:text-pitch-400">leagues</a>
      and <a href="/clubs/" class="text-pitch-700 hover:underline dark:text-pitch-400">clubs</a> instead.
    </p>
  </noscript>
</BaseLayout>

{/* Pagefind UI assets are generated into /pagefind/ by the post-build step. */}
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    if (typeof PagefindUI === "undefined") {
      document.getElementById("search").innerHTML =
        '<p class="text-sm text-slate-500">Search index not found. It is generated at build time — run a production build (npm run build && npx pagefind --site dist).</p>';
      return;
    }
    new PagefindUI({ element: "#search", showSubResults: true, showImages: false });
  });
</script>
